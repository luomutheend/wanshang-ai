}

.error-bar {
  width: 92%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-radius: 20px;
  background-color: rgba(255, 77, 79, 0.22);
  margin-top: 16px;
}

.error-text {
  flex: 1;
  min-width: 0;
  font-size: 24px;
