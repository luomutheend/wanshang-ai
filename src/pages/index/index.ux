}

.bottom-pad {
  width: 100%;
  height: 140px;
}

.status-float {
  position: absolute;
  bottom: 108px;
  left: 33px;
  width: 400px;
  padding: 12px 20px;
  border-radius: 20px;
  background-color: rgba(30, 30, 30, 0.95);
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.status-text {
  flex: 1;
  font-size: 22px;
  color: rgba(255, 255, 255, 0.85);
}

.status-cancel {
  margin-left: 12px;
  padding: 2px 4px;
  font-size: 22px;
  color: #8ab0ff;
}

// 「要不要联网」确认条：盖在状态条的位置，比状态条高，两行文字加一排按钮
.ask-bar {
  position: absolute;
  bottom: 108px;
  padding: 14px 20px 16px;
  border-radius: 22px;
  background-color: rgba(26, 28, 34, 0.97);
  border: 2px solid rgba(122, 146, 255, 0.28);
  flex-direction: column;
  align-items: flex-start;
}

.ask-title {
  font-size: 22px;
  color: #ffffff;
}

.ask-query {
  margin-top: 6px;
